{
  "name": "dsh-chat-plus",
  "version": "1.2.0",
  "description": "DeepSeek Harness 对话体验增强套件（零源码改动、纯插件注入）。Seeker 双栏执行大盘：右栏任务 / 操作面板 / 子智能体 / 产出物四张卡 + 记忆钉底，左栏只留一行状态卡与贴进对话流的思考卡、问答卡（字号跟随官方「设置 → 字号」）。正文可出卡片：html 沙箱（跑真 HTML/JS）、diagram 流程图、iu 原生交互卡、proto-tabs。另有对话截图、download 下载工具、裸路径转链接，供应商中心（API Key / 网络代理 / 生图识图生视频 / AnySearch，入口在官方设置「供应商」页），以及记忆 / 灵魂 / 能力 / 用量 / 画廊 / 邮箱六个工作台。",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "tool-summary",
    "activity-drawer",
    "flow-card",
    "screenshot",
    "download",
    "progress",
    "proto-tabs",
    "diagram",
    "html-card",
    "sandboxed-iframe",
    "chat-plus",
    "memory",
    "gallery",
    "media-gallery",
    "automation",
    "usage",
    "skills",
    "mcp",
    "mail",
    "email",
    "agent-mail",
    "agently",
    "provider",
    "provider-hub",
    "network-proxy",
    "proxy",
    "model-capabilities",
    "prompt-optimize",
    "anysearch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kr-ATG/dsh-chat-plus.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib",
    "assets",
    "scripts",
    "build.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-client.mjs && node scripts/smoke-host.mjs && node scripts/smoke-triad-client.mjs && node scripts/smoke-triad-host.mjs && node scripts/test-mail-two-phase.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:triad-client": "node scripts/smoke-triad-client.mjs",
    "smoke:triad-host": "node scripts/smoke-triad-host.mjs",
    "test": "node scripts/test-skill-manager.mjs && node scripts/test-skill-toggles.mjs && node scripts/test-subagent-catalog.mjs",
    "test:mail": "node scripts/test-mail-two-phase.mjs",
    "test:subagents": "node scripts/test-subagent-catalog.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "markdown-it": "^15.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.4.3",
    "yauzl": "^2.10.0"
  }
}
