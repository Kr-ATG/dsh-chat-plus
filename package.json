{
  "name": "dsh-chat-plus",
  "version": "1.11.2",
  "description": "DeepSeek Harness 对话体验增强套件（零源码改动、纯插件注入）。Seeker 双栏执行大盘：任务 / 操作面板（9 段任务动画）/ 子智能体 / 产出物四张卡；正文可出 html 沙箱、diagram 流程图、iu 原生交互卡与 proto-tabs；另有 @ 运行中的程序、对话截图、下载工具、裸路径转链接、对话完成胶囊；供应商中心（API Key / 网络代理 / 生图识图生视频 / AnySearch）；记忆 / SKILL / 用量 / 画廊 / 档案 / 系统提示词 / 同步设置七个工作台（档案支持账号密码、证件与任意文件附件，敏感值加密落盘且绝不进上下文）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "tool-summary",
    "activity-drawer",
    "flow-card",
    "screenshot",
    "download",
    "progress",
    "proto-tabs",
    "diagram",
    "html-card",
    "running-apps",
    "window-list",
    "sandboxed-iframe",
    "chat-plus",
    "memory",
    "gallery",
    "media-gallery",
    "automation",
    "usage",
    "skills",
    "mcp",
    "mail",
    "email",
    "agent-mail",
    "agently",
    "provider",
    "provider-hub",
    "network-proxy",
    "proxy",
    "model-capabilities",
    "prompt-optimize",
    "anysearch",
    "vault",
    "password-manager",
    "done-pill",
    "notification",
    "screen-recorder"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kr-ATG/dsh-chat-plus.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./packages/*": "./packages/*/index.js",
    "./packages/*/locale/zh.json": "./packages/*/locale/zh.json",
    "./packages/*/locale/en.json": "./packages/*/locale/en.json",
    "./packages/*/icon.svg": "./packages/*/icon.svg",
    "./packages/*/icon": "./packages/*/icon.svg",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "scripts",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "packages",
    "locale",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-client.mjs && node scripts/smoke-host.mjs && node scripts/smoke-triad-client.mjs && node scripts/smoke-triad-host.mjs && node scripts/test-session-isolation.mjs && node scripts/test-browser-on-demand.mjs && node scripts/test-mail-two-phase.mjs && node scripts/test-mail-channel.mjs && node scripts/test-html-card-width.mjs && node scripts/test-mail-drawer.mjs && node scripts/test-settings-card.mjs && node scripts/test-running-apps.mjs && node scripts/test-at-guard.mjs && node scripts/test-turn-input-images.mjs && node scripts/test-prompt-optimize-clean.mjs && node scripts/test-vault.mjs && node scripts/test-vault-http.mjs && node scripts/test-system-prompt.mjs && node scripts/test-scrollbar-autohide.mjs && node scripts/test-usage-hours.mjs && node scripts/test-feature-switches.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:triad-client": "node scripts/smoke-triad-client.mjs",
    "smoke:triad-host": "node scripts/smoke-triad-host.mjs",
    "test": "node scripts/test-skill-manager.mjs && node scripts/test-skill-preview.mjs && node scripts/test-skill-toggles.mjs && node scripts/test-subagent-catalog.mjs",
    "test:mail": "node scripts/test-mail-two-phase.mjs",
    "test:mail-channel": "node scripts/test-mail-channel.mjs",
    "test:skill-preview": "node scripts/test-skill-preview.mjs",
    "test:subagents": "node scripts/test-subagent-catalog.mjs",
    "test:session-isolation": "node scripts/test-session-isolation.mjs",
    "test:browser-on-demand": "node scripts/test-browser-on-demand.mjs",
    "test:browser-activity": "node scripts/test-browser-activity.mjs",
    "test:browser-flag": "node scripts/test-browser-flag.mjs",
    "test:html-card-width": "node scripts/test-html-card-width.mjs",
    "test:running-apps": "node scripts/test-running-apps.mjs",
    "test:at-guard": "node scripts/test-at-guard.mjs",
    "test:turn-input-images": "node scripts/test-turn-input-images.mjs",
    "test:prompt-optimize": "node scripts/test-prompt-optimize-clean.mjs",
    "test:vault": "node scripts/test-vault.mjs",
    "test:vault-http": "node scripts/test-vault-http.mjs",
    "test:system-prompt": "node scripts/test-system-prompt.mjs",
    "test:scrollbar-autohide": "node scripts/test-scrollbar-autohide.mjs",
    "test:usage-hours": "node scripts/test-usage-hours.mjs",
    "test:feature-switches": "node scripts/test-feature-switches.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "markdown-it": "^15.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.4.3",
    "yauzl": "^2.10.0"
  },
  "icon": "./icon.svg"
}
