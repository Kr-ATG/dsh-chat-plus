{
  "name": "dsh-chat-plus",
  "version": "1.6.0",
  "description": "DeepSeek Harness 对话体验增强套件（零源码改动、纯插件注入）。Seeker 双栏执行大盘：右栏任务 / 操作面板（卡头是 9 段按状态切换的任务动画）/ 子智能体 / 产出物四张卡 + 记忆钉底，左栏只留一行状态卡与贴进对话流的思考卡、问答卡（字号跟随官方「设置 → 字号」）。正文可出卡片：html 沙箱（跑真 HTML/JS）、diagram 流程图、iu 原生交互卡、proto-tabs。另有「@ 运行中的程序」候选（把此刻开着的窗口带进对话）、对话截图、download 下载工具、裸路径转链接，供应商中心（API Key / 网络代理 / 生图识图生视频 / AnySearch，入口在官方设置「供应商」页），以及记忆 / SKILL / 用量 / 画廊 / 档案五个工作台（档案 = 结构化账号密码 / 支付方式 / 联系方式 / 证件，敏感值加密落盘且绝不进上下文）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "tool-summary",
    "activity-drawer",
    "flow-card",
    "screenshot",
    "download",
    "progress",
    "proto-tabs",
    "diagram",
    "html-card",
    "running-apps",
    "window-list",
    "sandboxed-iframe",
    "chat-plus",
    "memory",
    "gallery",
    "media-gallery",
    "automation",
    "usage",
    "skills",
    "mcp",
    "mail",
    "email",
    "agent-mail",
    "agently",
    "provider",
    "provider-hub",
    "network-proxy",
    "proxy",
    "model-capabilities",
    "prompt-optimize",
    "anysearch",
    "vault",
    "password-manager"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kr-ATG/dsh-chat-plus.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "scripts",
    "build.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-client.mjs && node scripts/smoke-host.mjs && node scripts/smoke-triad-client.mjs && node scripts/smoke-triad-host.mjs && node scripts/test-session-isolation.mjs && node scripts/test-browser-on-demand.mjs && node scripts/test-mail-two-phase.mjs && node scripts/test-mail-channel.mjs && node scripts/test-html-card-width.mjs && node scripts/test-mail-drawer.mjs && node scripts/test-settings-card.mjs && node scripts/test-running-apps.mjs && node scripts/test-at-guard.mjs && node scripts/test-prompt-optimize-clean.mjs && node scripts/test-vault.mjs && node scripts/test-vault-http.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:triad-client": "node scripts/smoke-triad-client.mjs",
    "smoke:triad-host": "node scripts/smoke-triad-host.mjs",
    "test": "node scripts/test-skill-manager.mjs && node scripts/test-skill-preview.mjs && node scripts/test-skill-toggles.mjs && node scripts/test-subagent-catalog.mjs",
    "test:mail": "node scripts/test-mail-two-phase.mjs",
    "test:mail-channel": "node scripts/test-mail-channel.mjs",
    "test:skill-preview": "node scripts/test-skill-preview.mjs",
    "test:subagents": "node scripts/test-subagent-catalog.mjs",
    "test:session-isolation": "node scripts/test-session-isolation.mjs",
    "test:browser-on-demand": "node scripts/test-browser-on-demand.mjs",
    "test:browser-activity": "node scripts/test-browser-activity.mjs",
    "test:browser-flag": "node scripts/test-browser-flag.mjs",
    "test:html-card-width": "node scripts/test-html-card-width.mjs",
    "test:running-apps": "node scripts/test-running-apps.mjs",
    "test:at-guard": "node scripts/test-at-guard.mjs",
    "test:prompt-optimize": "node scripts/test-prompt-optimize-clean.mjs",
    "test:vault": "node scripts/test-vault.mjs",
    "test:vault-http": "node scripts/test-vault-http.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "markdown-it": "^15.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.4.3",
    "yauzl": "^2.10.0"
  }
}
